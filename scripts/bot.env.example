# BUG_REPORTING=1
# GITHUB_BUG_TOKEN_FILE=/absolute/path/to/github-issues-token
HISCORES_CATEGORY_ID=YOUR_HISCORES_CATEGORY_ID
DISCORD_LINK_TOKEN_FILE=/absolute/path/to/the-private-game-link-api-token
DISCORD_BOT_TOKEN_FILE=/absolute/path/to/your-bot-token
DATABASE_PATH=/absolute/path/to/levels.sqlite
